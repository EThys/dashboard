# ==============================================
# CasaNayo Dashboard — Variables d'environnement
# ==============================================
# Copier ce fichier en .env sur le serveur Hetzner
# puis remplir les valeurs réelles

# URL de base de l'API backend
NUXT_PUBLIC_API_BASE=https://server.casanayo.com/api

# URL de base pour l'authentification
NUXT_PUBLIC_AUTH_BASE=https://server.casanayo.com

# Environnement (production | development)
NODE_ENV=production

# Google Analytics 4 (Admin → Flux de données → ID de mesure, forme G-XXXXXXXX)
# Vide = suivi désactivé. Le script ne part qu'après « Tout accepter » sur le bandeau cookies.
NUXT_PUBLIC_GA_MEASUREMENT_ID=G-F7480H21M3
